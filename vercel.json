{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/bio", "destination": "/about", "permanent": true }
  ],
  "headers": [
    { "source": "/opengraph-image", "headers": [{ "key": "Content-Type", "value": "image/png" }] },
    { "source": "/projects/:slug/opengraph-image", "headers": [{ "key": "Content-Type", "value": "image/png" }] },
    { "source": "/icon", "headers": [{ "key": "Content-Type", "value": "image/png" }] },
    { "source": "/apple-icon", "headers": [{ "key": "Content-Type", "value": "image/png" }] }
  ]
}
